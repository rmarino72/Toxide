<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
        <RootNamespace>Toxide</RootNamespace>
        <AssemblyName>Toxide</AssemblyName>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <!-- NuGet package -->
    <PropertyGroup>
        <PackageId>Toxide</PackageId>
        <Version>0.1.0</Version>
        <Authors>Rosario Marino</Authors>
        <Description>A fully managed .NET implementation of the Tox protocol, wire-compatible with toxcore and qTox: DHT, onion routing, net_crypto sessions, friend requests, messages with read receipts, presence, file transfers and toxcore/qTox profiles (including encrypted toxEsave profiles). No native dependencies.</Description>
        <PackageTags>tox;toxcore;qtox;p2p;peer-to-peer;messaging;chat;encryption;dht;onion;curve25519</PackageTags>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/rmarino72/Toxide</PackageProjectUrl>
        <RepositoryUrl>https://github.com/rmarino72/Toxide.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>See https://github.com/rmarino72/Toxide/blob/main/CHANGELOG.md</PackageReleaseNotes>
        <Copyright>Copyright © 2026 Rosario Marino</Copyright>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Not every public member has XML docs yet. -->
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Tests" />
    </ItemGroup>

</Project>
